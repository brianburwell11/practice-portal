{
  "name": "practice-portal",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsx scripts/gen-licenses.ts && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prod": "tsc -b && vite build && vite preview --open",
    "prepare": "git config core.hooksPath .hooks",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "licenses:gen": "tsx scripts/gen-licenses.ts",
    "db:seed:gen": "tsx scripts/gen-seed-migration.ts",
    "db:verify": "tsx scripts/gen-seed-migration.ts --check && tsx scripts/verify-db.ts",
    "db:verify:remote": "tsx scripts/gen-seed-migration.ts --check && tsx scripts/verify-db.ts --url",
    "smoke:media": "tsx scripts/mscz-smoke.ts",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/server.js",
    "start": "node dist-server/server.js",
    "smoke:server": "tsx scripts/server-smoke.ts",
    "build:smoke": "esbuild scripts/mscz-smoke.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/mscz-smoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@soundtouchjs/audio-worklet": "^1.0.9",
    "busboy": "^1.6.0",
    "drizzle-orm": "0.45.4",
    "jszip": "^3.10.2",
    "opensheetmusicdisplay": "^1.9.7",
    "postgres": "3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.14.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/busboy": "^1.5.5",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.4.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.2.2",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.1"
  }
}
